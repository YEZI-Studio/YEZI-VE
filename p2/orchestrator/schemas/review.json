{
  "type": "object", "required": ["shots"],
  "properties": {"shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "pass", "score", "issues"],
    "properties": {"id": {"type": "string", "pattern": "^s[0-9]{2}$"}, "pass": {"type": "boolean"},
                   "score": {"type": "integer", "minimum": 1, "maximum": 5},
