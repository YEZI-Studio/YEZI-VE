                     "properties": {"rule": {"type": "string"}, "where": {"type": "string"}, "fix": {"type": "string", "minLength": 2}}}}}}},
                 "cuts": {"type": "array", "description": "切点核对（只作建议）：cut = 下一镜 id", "items": {"type": "object", "required": ["cut", "ok"],
                   "properties": {"cut": {"type": "string"}, "declared": {"type": "string"}, "seen": {"type": "string"},
                                  "ok": {"type": "boolean"}, "fix": {"type": "string"}}}}}
}
